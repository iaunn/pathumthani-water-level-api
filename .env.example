# Object storage (MinIO, Cloudflare R2, or AWS S3)
S3_BUCKET=water-level
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Where the app writes. Omit for AWS S3; set for MinIO or R2.
S3_ENDPOINT_URL=http://localhost:9000
# Where browsers read. A public bucket URL or CDN domain.
S3_PUBLIC_BASE_URL=http://localhost:9000/water-level
# "auto" suits R2 and MinIO; use the real region for AWS S3.
S3_REGION=auto
# R2 and AWS need "virtual"; MinIO needs "path".
S3_ADDRESSING_STYLE=path

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=water_level

CACHE_TTL=300
MAX_KEEP_IMAGES=200

# --- MediaMTX ---------------------------------------------------------------
# The app reads every camera through MediaMTX, so stations.json points at
# http://mediamtx:8888/<station>/index.m3u8 rather than at the cameras.
#
# These two are MediaMTX's own environment overrides (MTX_PATHS_<PATH>_<PARAM>).
# They carry the Axis camera password, which is why they live here and not in
# mediamtx.yml. Keep the URL-encoding in mind: a '!' is fine, but '@' or ':' in
# a password must be percent-encoded.
MTX_PATHS_BRIDGE1_SOURCE=rtsp://USER:PASS@tc100224.dyndns.info:554/axis-media/media.amp
MTX_PATHS_BRIDGE2_RUNONDEMAND=ffmpeg -nostdin -rtsp_transport http -i rtsp://USER:PASS@ta100219.dyndns.info:5001/axis-media/media.amp -c copy -f rtsp rtsp://localhost:8554/bridge2

# --- camera credentials -----------------------------------------------------
# Stations that need a login name the variable holding it, so stations.json --
# which is committed -- carries none. Format is user:password.
STATION_PATHUMBRIDGE_CREDENTIALS=USER:PASS
