# Object storage (MinIO, Cloudflare R2, or AWS S3)
S3_BUCKET=water-level
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# Where the app writes. Omit for AWS S3; set for MinIO or R2.
S3_ENDPOINT_URL=http://localhost:9000
# Where browsers read. A public bucket URL or CDN domain.
S3_PUBLIC_BASE_URL=http://localhost:9000/water-level
# "auto" suits R2 and MinIO; use the real region for AWS S3.
S3_REGION=auto
# R2 and AWS need "virtual"; MinIO needs "path".
S3_ADDRESSING_STYLE=path

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=water_level

CACHE_TTL=300
MAX_KEEP_IMAGES=200
